{
  "name": "@audio/tune-snap",
  "version": "2.0.1",
  "description": "Pitch correction to a scale: each note's centre moved onto its note, its slow drift flattened, the voice's own cycles re-spaced along one pitch curve (Auto-Tune / Melodyne class)",
  "type": "module",
  "sideEffects": false,
  "main": "snap.js",
  "exports": {
    ".": "./snap.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "snap.js",
    "audio.js",
    "audio.d.ts",
    "snap.d.ts"
  ],
  "dependencies": {
    "@audio/note": "^1.0.0",
    "@audio/pitch-pyin": "^2.0.0",
    "@audio/tune-curve": "^0.3.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "pitch-correction",
    "autotune",
    "tune"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./snap.d.ts",
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/tune.git",
    "directory": "packages/tune-snap"
  },
  "funding": "https://github.com/sponsors/audiojs"
}

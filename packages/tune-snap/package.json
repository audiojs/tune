{
  "name": "@audio/tune-snap",
  "version": "1.1.3",
  "description": "Pitch correction — YIN track → note segments → scale snap → PSOLA retune (Auto-Tune class, per-note v1)",
  "type": "module",
  "sideEffects": false,
  "main": "snap.js",
  "exports": {
    ".": "./snap.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "snap.js",
    "audio.js",
    "audio.d.ts",
    "snap.d.ts"
  ],
  "dependencies": {
    "@audio/pitch-yin": "^1.0.0",
    "@audio/note": "^1.0.0",
    "@audio/shift-psola": "^1.0.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "pitch-correction",
    "autotune",
    "tune"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./snap.d.ts",
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/tune.git",
    "directory": "packages/tune-snap"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
